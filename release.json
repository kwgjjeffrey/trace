{
  "schemaVersion": 1,
  "package": "trace",
  "version": "0.2.2",
  "kind": "local",
  "provider": {
    "type": "github-releases",
    "repository": "kwgjjeffrey/trace"
  },
  "source": {
    "repository": "https://github.com/kwgjjeffrey/trace.git",
    "commitPolicy": "freeze HEAD into trace-release.json at build"
  },
  "artifacts": [
    "dist/trace-0.2.2.tgz",
    "dist/trace-release.json"
  ],
  "commands": {
    "build": [
      "node",
      "release/build.mjs"
    ],
    "validate": [
      "npm",
      "test"
    ],
    "accept": [
      "node",
      "setup/setup.mjs",
      "release-check"
    ]
  },
  "channel": "stable"
}
